<UserControl x:Class="AudioAnalyzer.Wpf.Views.SpectrumDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AudioAnalyzer.Wpf.Converters"
             x:Name="root"
             MinHeight="24">
    <UserControl.Resources>
        <conv:LevelToStarConverter x:Key="LevelToStar" />
    </UserControl.Resources>

    <Border Background="{DynamicResource LBrush.ProgressBar.Background.Normal}"
            BorderBrush="{DynamicResource LBrush.ProgressBar.Border.Normal}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <ItemsControl ItemsSource="{Binding Bands, ElementName=root}"
                      Margin="2"
                      SnapsToDevicePixels="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0.5,0" Background="Transparent">
                        <Grid.ToolTip>
                            <ToolTip Content="{Binding Range}" />
                        </Grid.ToolTip>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding Level, Converter={StaticResource LevelToStar}, ConverterParameter=invert}" />
                            <RowDefinition Height="{Binding Level, Converter={StaticResource LevelToStar}}" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="1"
                                   Fill="{DynamicResource LBrush.ProgressBar.Foreground.Normal}"
                                   SnapsToDevicePixels="True" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
