<UserControl x:Class="AudioAnalyzer.Wpf.Views.AudioAnalyzerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:baseControls="clr-namespace:LumosControlsWPF.Controls.BaseControls;assembly=LumosControlsWPF"
             xmlns:conv="clr-namespace:AudioAnalyzer.Wpf.Converters"
             xmlns:views="clr-namespace:AudioAnalyzer.Wpf.Views"
        xmlns:T="clr-namespace:LumosLIB.WPF.Tools.I18n;assembly=LumosToolsLIB.WPF"
             x:Name="root"
             MinWidth="280">
    <UserControl.Resources>
        <conv:LevelToStarConverter x:Key="LevelToStar" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SettingsSection"
               BasedOn="{StaticResource {x:Type baseControls:LumosExpander}}"
               TargetType="{x:Type baseControls:LumosExpander}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HeaderBackground" Value="{DynamicResource LBrush.Background.Normal06}" />
            <Setter Property="HeaderPadding" Value="10,4" />
            <Setter Property="HeaderMargin" Value="0,0,0,2" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock FontSize="16" Text="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HorizontalButtonAlignment" Value="Right" />
            <Setter Property="ContentPadding" Value="0" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource LBrush.Foreground.Normal01}" />
        </Style>

        <Style x:Key="SettingValue" TargetType="{x:Type TextBlock}">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource LBrush.Foreground.Normal01}" />
        </Style>

        <Style x:Key="PlaceholderText" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,2,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource LBrush.Foreground.Disabled01}" />
        </Style>

        <Style x:Key="MonitorCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource LBrush.Foreground.Normal02}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource LBrush.Background.Normal01}">

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource LBrush.Background.Normal02}"
                BorderBrush="{DynamicResource LBrush.Border.Normal01}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <Ellipse Width="48"
                             Height="48"
                             StrokeThickness="2"
                             ToolTip="{Binding BeatSourceText}">
                        <Ellipse.Style>
                            <Style TargetType="{x:Type Ellipse}">
                                <Setter Property="Fill" Value="{DynamicResource LBrush.ProgressBar.Background.Normal}" />
                                <Setter Property="Stroke" Value="{DynamicResource LBrush.ProgressBar.Border.Normal}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BeatSource}" Value="Detected">
                                        <Setter Property="Fill" Value="{DynamicResource LBrush.CommandLine.Status.Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BeatSource}" Value="Predicted">
                                        <Setter Property="Fill" Value="{DynamicResource LBrush.CommandLine.Status.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BeatSource}" Value="GeneratorMain">
                                        <Setter Property="Fill" Value="{DynamicResource LBrush.ProgressBar.Foreground.Normal}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BeatSource}" Value="GeneratorSub">
                                        <Setter Property="Fill" Value="{DynamicResource LBrush.ProgressBar.Foreground.Normal}" />
                                        <Setter Property="Opacity" Value="0.45" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               Foreground="{DynamicResource LBrush.Foreground.Normal01}"
                               Text="{Binding BpmText}" />
                    <TextBlock Style="{StaticResource MonitorCaption}"
                               HorizontalAlignment="Center"
                               Text="{T:_ 'BPM'}" />
                </StackPanel>

                <UniformGrid Grid.Column="1"
                             Columns="1"
                             MinHeight="72">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource MonitorCaption}"
                                   Width="26"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Spectrum.PrimaryChannelLabel}" />
                        <views:SpectrumDisplayControl Grid.Column="1"
                                                      Bands="{Binding Spectrum.Bands}" />
                    </Grid>

                    <Grid Margin="0,4,0,0"
                          Visibility="{Binding Spectrum.Stereo, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource MonitorCaption}"
                                   Width="26"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Text="R" />
                        <views:SpectrumDisplayControl Grid.Column="1"
                                                      Bands="{Binding Spectrum.BandsRight}" />
                    </Grid>
                </UniformGrid>

                <StackPanel Grid.Column="2"
                            Margin="10,0,0,0"
                            Orientation="Horizontal">
                    <DockPanel Width="16" Margin="0,0,4,0">
                        <TextBlock DockPanel.Dock="Bottom"
                                   Style="{StaticResource MonitorCaption}"
                                   Margin="0,1,0,0"
                                   HorizontalAlignment="Center"
                                   Text="L" />
                        <Border Background="{DynamicResource LBrush.ProgressBar.Background.Normal}"
                                BorderBrush="{DynamicResource LBrush.ProgressBar.Border.Normal}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding LevelLeft, Converter={StaticResource LevelToStar}, ConverterParameter=invert}" />
                                    <RowDefinition Height="{Binding LevelLeft, Converter={StaticResource LevelToStar}}" />
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="1"
                                           Fill="{DynamicResource LBrush.ProgressBar.Foreground.Normal}" />
                            </Grid>
                        </Border>
                    </DockPanel>
                    <DockPanel Width="16" Margin="0">
                        <TextBlock DockPanel.Dock="Bottom"
                                   Style="{StaticResource MonitorCaption}"
                                   Margin="0,1,0,0"
                                   HorizontalAlignment="Center"
                                   Text="R" />
                        <Border Background="{DynamicResource LBrush.ProgressBar.Background.Normal}"
                                BorderBrush="{DynamicResource LBrush.ProgressBar.Border.Normal}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{Binding LevelRight, Converter={StaticResource LevelToStar}, ConverterParameter=invert}" />
                                    <RowDefinition Height="{Binding LevelRight, Converter={StaticResource LevelToStar}}" />
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="1"
                                           Fill="{DynamicResource LBrush.ProgressBar.Foreground.Normal}" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            MinWidth="124"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                    <Button Padding="10,6"
                            Command="{Binding ToggleRunCommand}"
                            Content="{Binding Device.RunButtonText}" />

                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <Button Margin="0,0,3,0"
                                Padding="10,3"
                                Command="{Binding SyncCommand}"
                                Content="{T:_ 'Sync'}" />
                        <Button Margin="3,0,0,0"
                                Padding="10,3"
                                Command="{Binding BeatDetection.ResetCommand}"
                                Content="{T:_ 'Reset'}" />
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="10,8">
            <StackPanel HorizontalAlignment="Left"
                        MinWidth="375"
                        MaxWidth="620">

                <baseControls:LumosExpander Header="{T:_ 'Device'}"
                          IsExpanded="True"
                          Style="{StaticResource SettingsSection}">
                    <Grid Margin="18,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Text="{T:_ 'Device'}" />
                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding Device.Devices}"
                                  SelectedItem="{Binding Device.SelectedDevice}" />

                        <!--  nur ASIO liefert Eingangskanaele  -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,10,12,0"
                                   Text="{T:_ 'Input'}"
                                   Visibility="{Binding Device.HasInputChannels, Converter={StaticResource BoolToVis}}" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,10,0,0"
                                  ItemsSource="{Binding Device.InputChannels}"
                                  SelectedIndex="{Binding Device.SelectedInputChannel}"
                                  Visibility="{Binding Device.HasInputChannels, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,12,12,0"
                                   Text="{T:_ 'Gain'}" />
                        <Slider Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="10"
                                Value="{Binding Device.MainGain}" />

                    </Grid>
                </baseControls:LumosExpander>

                <baseControls:LumosExpander Header="{T:_ 'Spectrum'}" Style="{StaticResource SettingsSection}">
                    <Grid Margin="18,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Text="{T:_ 'Number of bands'}" />
                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  ItemsSource="{Binding Spectrum.AvailableBandCounts}"
                                  SelectedItem="{Binding Spectrum.BandCount}" />

                        <CheckBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,10,0,0"
                                  Content="{T:_ 'Separate bands for left/right'}"
                                  IsChecked="{Binding Spectrum.Stereo}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,12,12,0"
                                   Text="{T:_ 'Level correction'}" />
                        <Slider Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="10"
                                Value="{Binding Spectrum.Gain}" />
                    </Grid>
                </baseControls:LumosExpander>

                <baseControls:LumosExpander Header="{T:_ 'VU meter'}" Style="{StaticResource SettingsSection}">
                    <Grid Margin="18,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Text="{T:_ 'Level correction'}" />
                        <Slider Grid.Row="0"
                                Grid.Column="1"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="10"
                                Value="{Binding VuMeter.Gain}" />

                        <CheckBox Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="0,10,0,0"
                                  Content="{T:_ 'Peak sink'}"
                                  IsChecked="{Binding VuMeter.PeakHold}" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,12,12,0"
                                   Text="{T:_ 'Peak hold time'}" />
                        <DockPanel Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource SettingValue}"
                                       DockPanel.Dock="Right"
                                       Text="{Binding VuMeter.PeakHoldTime}" />
                            <Slider IsEnabled="{Binding VuMeter.PeakHold}"
                                    IsSnapToTickEnabled="True"
                                    Maximum="500"
                                    Minimum="25"
                                    TickFrequency="25"
                                    Value="{Binding VuMeter.PeakHoldTime}" />
                        </DockPanel>
                    </Grid>
                </baseControls:LumosExpander>

                <baseControls:LumosExpander Header="{T:_ 'Beat detection'}" Style="{StaticResource SettingsSection}">
                    <Grid Margin="18,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Text="{T:_ 'Algorithm'}" />
                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  ItemsSource="{Binding BeatDetection.Algorithms}"
                                  SelectedIndex="{Binding BeatDetection.Algorithm}" />

                        <!--  zwei der vier Verfahren werten die Empfindlichkeit nicht aus  -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,12,12,0"
                                   Text="{T:_ 'Sensitivity'}"
                                   Visibility="{Binding BeatDetection.SensitivityRelevant, Converter={StaticResource BoolToVis}}" />
                        <Slider Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="10"
                                Value="{Binding BeatDetection.Sensitivity}"
                                Visibility="{Binding BeatDetection.SensitivityRelevant, Converter={StaticResource BoolToVis}}" />

                        <CheckBox Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,12,0,0"
                                  Content="{T:_ 'Limit maximum tempo'}"
                                  IsChecked="{Binding BeatDetection.MaxBpmLimit}" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,10,12,0"
                                   Text="{T:_ 'Maximum BPM'}" />
                        <DockPanel Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource SettingValue}"
                                       DockPanel.Dock="Right"
                                       Text="{Binding BeatDetection.MaxBpm}" />
                            <Slider IsEnabled="{Binding BeatDetection.MaxBpmLimit}"
                                    Maximum="330"
                                    Minimum="30"
                                    TickFrequency="30"
                                    Value="{Binding BeatDetection.MaxBpm}" />
                        </DockPanel>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,12,12,0"
                                   Text="{T:_ 'Predicted beats'}" />
                        <Slider Grid.Row="4"
                                Grid.Column="1"
                                Margin="0,12,0,0"
                                Maximum="100"
                                Minimum="0"
                                TickFrequency="10"
                                Value="{Binding BeatDetection.ForecastCount}" />
                        <TextBlock Grid.Row="5"
                                   Grid.Column="1"
                                   Style="{StaticResource PlaceholderText}"
                                   Margin="0,2,0,0"
                                   Text="{Binding BeatDetection.ForecastText}" />

                        <StackPanel Grid.Row="6"
                                    Grid.Column="1"
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal">
                            <CheckBox Content="{T:_ 'Double'}"
                                      IsChecked="{Binding BeatDetection.DoubleSpeed}" />
                            <CheckBox Margin="16,0,0,0"
                                      Content="{T:_ 'Half'}"
                                      IsChecked="{Binding BeatDetection.HalfSpeed}" />
                        </StackPanel>
                    </Grid>
                </baseControls:LumosExpander>

                <baseControls:LumosExpander Header="{T:_ 'Beat generator'}" Style="{StaticResource SettingsSection}">
                    <Grid Margin="18,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0"
                                  Grid.Column="1"
                                  Content="{T:_ 'Use generator instead of detection'}"
                                  IsChecked="{Binding Generator.Enabled}" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,12,12,0"
                                   Text="{T:_ 'Tempo (BPM)'}" />
                        <!--  das alte Fenster hatte hier ein NumericUpDown, der Wert muss sichtbar bleiben  -->
                        <DockPanel Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource SettingValue}"
                                       DockPanel.Dock="Right"
                                       Text="{Binding Generator.Bpm}" />
                            <Slider IsEnabled="{Binding Generator.Enabled}"
                                    Maximum="300"
                                    Minimum="1"
                                    TickFrequency="30"
                                    Value="{Binding Generator.Bpm}" />
                        </DockPanel>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="0,12,12,0"
                                   Text="{T:_ 'Rhythm'}" />
                        <ComboBox Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,12,0,0"
                                  IsEnabled="{Binding Generator.Enabled}"
                                  ItemsSource="{Binding Generator.Rhythms}"
                                  SelectedIndex="{Binding Generator.Rhythm}" />

                        <StackPanel Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,14,0,0"
                                    Orientation="Horizontal">
                            <Button Padding="16,4"
                                    Command="{Binding Generator.TapCommand}"
                                    Content="{T:_ 'Tap'}" />
                        </StackPanel>
                    </Grid>
                </baseControls:LumosExpander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
